{:paths ["src"]

 ;; glimmer (the toolkit-independent reactive core) and glimmer-appkit (its
 ;; AppKit backend for macOS) come from GitHub at their release tags. jolt's deps
 ;; resolver clones them by tag/sha and merges their :paths onto the classpath.
 ;; glimmer-appkit loads AppKit/CoreFoundation itself, so nothing has to be
 ;; re-declared here.
 :deps {jolt-lang/glimmer        {:git/url "https://github.com/jolt-lang/glimmer"
                                  :git/tag "v0.1.7"
                                  :git/sha "22350c4d047b05359a16b756b20f38ecb391a63b"}
        jolt-lang/glimmer-appkit {:git/url "https://github.com/jolt-lang/glimmer-appkit"
                                  :git/tag "v0.1.3"
                                  :git/sha "532b45e582e40bd2df20c2df3c777a1978f09fd1"}}

 ;; `jolt -M:run` (or `jolt start`) opens the window and blocks until it's
 ;; closed. `jolt build -m app.core` compiles a standalone binary; AppKit ships with macOS,
 ;; so nothing extra needs installing.
 :aliases {:run {:main-opts ["-m" "app.core"]}}

 :jolt/build {:opt true
              :direct-link true
              :tree-shake true}

 :tasks {start "jolt -M:run"}}
