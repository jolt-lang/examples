{:paths ["src"]

 ;; glimmer (the toolkit-independent reactive core) and glimmer-uikit (its AppKit
 ;; backend for macOS) are consumed from GitHub at the v0.1.0 release. jolt's deps
 ;; resolver clones them by tag/sha and merges their :paths onto the classpath.
 ;; glimmer-uikit loads AppKit/CoreFoundation itself (guarded to macOS only), so
 ;; nothing has to be re-declared here.
 :deps {jolt-lang/glimmer       {:git/url "https://github.com/jolt-lang/glimmer"
                                 :git/tag "v0.1.3"
                                 :git/sha "93758e82548daf75e357274558fc3e81bb754c9a"}
        jolt-lang/glimmer-uikit {:git/url "https://github.com/jolt-lang/glimmer-uikit"
                                 :git/tag "v0.2.1"
                                 :git/sha "676d8a341c359552ee1d9d7d42531e05c8476206"}}

 ;; `jolt -M:run` (or the `run` task) opens the window and blocks until it's
 ;; closed. `jolt build` compiles a standalone binary; AppKit ships with macOS,
 ;; so nothing extra needs installing.
 :aliases {:run {:main-opts ["-m" "app.core"]}}

 :jolt/build {:opt true
              :direct-link true
              :tree-shake true}

 :tasks {run  "jolt -M:run"
         build "jolt build -m app.core"}}
