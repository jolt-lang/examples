(guard (e (#t #f)) (jolt-invoke4 (var-deref "clojure.core" "attach-core-doc-meta!") "clojure.core" "find-keyword" "Returns a Keyword with the given namespace and name if one already\n  exists.  This function will not intern a new keyword. If the keyword\n  has not already been interned, it will return nil.  Do not use :\n  in the keyword strings, it will be added automatically." (jolt-list (jolt-vector (jolt-symbol #f "name")) (jolt-vector (jolt-symbol #f "ns") (jolt-symbol #f "name")))))
