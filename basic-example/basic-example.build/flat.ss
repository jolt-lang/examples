(guard (e (#t #f)) (jolt-invoke4 (var-deref "clojure.core" "attach-core-doc-meta!") "clojure.core" "nth" "Returns the value at the index. get returns nil if index out of\n  bounds, nth throws an exception unless not-found is supplied.  nth\n  also works for strings, Java arrays, regex Matchers and Lists, and,\n  in O(n) time, for sequences." (jolt-list (jolt-vector (jolt-symbol #f "coll") (jolt-symbol #f "index")) (jolt-vector (jolt-symbol #f "coll") (jolt-symbol #f "index") (jolt-symbol #f "not-found")))))
