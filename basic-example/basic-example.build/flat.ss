(guard (e (#t #f)) (jolt-invoke4 (var-deref "clojure.core" "attach-core-doc-meta!") "clojure.core" "filter" "Returns a lazy sequence of the items in coll for which\n  (pred item) returns logical true. pred must be free of side-effects.\n  Returns a transducer when no collection is provided." (jolt-list (jolt-vector (jolt-symbol #f "pred")) (jolt-vector (jolt-symbol #f "pred") (jolt-symbol #f "coll")))))
