(guard (e (#t #f)) (jolt-invoke4 (var-deref "clojure.core" "attach-core-doc-meta!") "clojure.core" "remove-method" "Removes the method of multimethod associated with dispatch-value." (jolt-list (jolt-vector (jolt-symbol #f "multifn") (jolt-symbol #f "dispatch-val")))))
