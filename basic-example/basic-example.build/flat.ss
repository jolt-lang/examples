             (vector-set! x i (sub (vector-ref x i)))
             (loop (fx+ i 1))))
         x)
        ((and (hashtable? x) (hashtable-mutable? x))
         (hashtable-set! memo x x)
         (let-values (((ks vs) (hashtable-entries x)))
