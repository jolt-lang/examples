(guard (e (#t #f)) (jolt-invoke4 (var-deref "clojure.core" "attach-core-doc-meta!") "clojure.core" "remove-tap" "Remove f from the tap set." (jolt-list (jolt-vector (jolt-symbol #f "f")))))
