(guard (e (#t #f)) (jolt-invoke4 (var-deref "clojure.core" "attach-core-doc-meta!") "clojure.core" "dissoc" "dissoc[iate]. Returns a new map of the same (hashed/sorted) type,\n  that does not contain a mapping for key(s)." (jolt-list (jolt-vector (jolt-symbol #f "map")) (jolt-vector (jolt-symbol #f "map") (jolt-symbol #f "key")) (jolt-vector (jolt-symbol #f "map") (jolt-symbol #f "key") (jolt-symbol #f "&") (jolt-symbol #f "ks")))))
