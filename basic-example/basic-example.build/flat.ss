(guard (e (#t #f)) (jolt-invoke4 (var-deref "clojure.core" "attach-core-doc-meta!") "clojure.core" "dec" "Returns a number one less than num. Does not auto-promote\n  longs, will throw on overflow. See also: dec'" (jolt-list (jolt-vector (jolt-symbol #f "x")))))
