(guard (e (#t #f)) (jolt-invoke4 (var-deref "clojure.core" "attach-core-doc-meta!") "clojure.core" "repeat" "Returns a lazy (infinite!, or length n if supplied) sequence of xs." (jolt-list (jolt-vector (jolt-symbol #f "x")) (jolt-vector (jolt-symbol #f "n") (jolt-symbol #f "x")))))
