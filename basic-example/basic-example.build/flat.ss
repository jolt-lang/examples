(guard (e (#t #f)) (jolt-invoke4 (var-deref "clojure.core" "attach-core-doc-meta!") "clojure.core" "seqable?" "Return true if the seq function is supported for x" (jolt-list (jolt-vector (jolt-symbol #f "x")))))
(guard (e (#t #f)) (jolt-invoke4 (var-deref "clojure.core" "attach-core-doc-meta!") "clojure.core" "seque" "Creates a queued seq on another (presumably lazy) seq s. The queued\n  seq will produce a concrete seq in the background, and can get up to\n  n items ahead of the consumer. n-or-q can be an integer n buffer\n  size, or an instance of java.util.concurrent BlockingQueue. Note\n  that reading from a seque can block if the reader gets ahead of the\n  producer." (jolt-list (jolt-vector (jolt-symbol #f "s")) (jolt-vector (jolt-symbol #f "n-or-q") (jolt-symbol #f "s")))))
(guard (e (#t #f)) (jolt-invoke4 (var-deref "clojure.core" "attach-core-doc-meta!") "clojure.core" "sequence" "Coerces coll to a (possibly empty) sequence, if it is not already\n  one. Will not force a lazy seq. (sequence nil) yields (), When a\n  transducer is supplied, returns a lazy sequence of applications of\n  the transform to the items in coll(s), i.e. to the set of first\n  items of each coll, followed by the set of second\n  items in each coll, until any one of the colls is exhausted.  Any\n  remaining items in other colls are ignored. The transform should accept\n  number-of-colls arguments" (jolt-list (jolt-vector (jolt-symbol #f "coll")) (jolt-vector (jolt-symbol #f "xform") (jolt-symbol #f "coll")) (jolt-vector (jolt-symbol #f "xform") (jolt-symbol #f "coll") (jolt-symbol #f "&") (jolt-symbol #f "colls")))))
(guard (e (#t #f)) (jolt-invoke4 (var-deref "clojure.core" "attach-core-doc-meta!") "clojure.core" "sequential?" "Returns true if coll implements Sequential" (jolt-list (jolt-vector (jolt-symbol #f "coll")))))
(guard (e (#t #f)) (jolt-invoke4 (var-deref "clojure.core" "attach-core-doc-meta!") "clojure.core" "set" "Returns a set of the distinct elements of coll." (jolt-list (jolt-vector (jolt-symbol #f "coll")))))
(guard (e (#t #f)) (jolt-invoke4 (var-deref "clojure.core" "attach-core-doc-meta!") "clojure.core" "set-agent-send-executor!" "Sets the ExecutorService to be used by send" (jolt-list (jolt-vector (jolt-symbol #f "executor")))))
(guard (e (#t #f)) (jolt-invoke4 (var-deref "clojure.core" "attach-core-doc-meta!") "clojure.core" "set-agent-send-off-executor!" "Sets the ExecutorService to be used by send-off" (jolt-list (jolt-vector (jolt-symbol #f "executor")))))
(guard (e (#t #f)) (jolt-invoke4 (var-deref "clojure.core" "attach-core-doc-meta!") "clojure.core" "set-error-handler!" "Sets the error-handler of agent a to handler-fn.  If an action\n  being run by the agent throws an exception or doesn't pass the\n  validator fn, handler-fn will be called with two arguments: the\n  agent and the exception." (jolt-list (jolt-vector (jolt-symbol #f "a") (jolt-symbol #f "handler-fn")))))
(guard (e (#t #f)) (jolt-invoke4 (var-deref "clojure.core" "attach-core-doc-meta!") "clojure.core" "set-error-mode!" "Sets the error-mode of agent a to mode-keyword, which must be\n  either :fail or :continue.  If an action being run by the agent\n  throws an exception or doesn't pass the validator fn, an\n  error-handler may be called (see set-error-handler!), after which,\n  if the mode is :continue, the agent will continue as if neither the\n  action that caused the error nor the error itself ever happened.\n  \n  If the mode is :fail, the agent will become failed and will stop\n  accepting new 'send' and 'send-off' actions, and any previously\n  queued actions will be held until a 'restart-agent'.  Deref will\n  still work, returning the state of the agent before the error." (jolt-list (jolt-vector (jolt-symbol #f "a") (jolt-symbol #f "mode-keyword")))))
(guard (e (#t #f)) (jolt-invoke4 (var-deref "clojure.core" "attach-core-doc-meta!") "clojure.core" "set-validator!" "Sets the validator-fn for a var/ref/agent/atom. validator-fn must be nil or a\n  side-effect-free fn of one argument, which will be passed the intended\n  new state on any state change. If the new state is unacceptable, the\n  validator-fn should return false or throw an exception. If the current state (root\n  value if var) is not acceptable to the new validator, an exception\n  will be thrown and the validator will not be changed." (jolt-list (jolt-vector (jolt-symbol #f "iref") (jolt-symbol #f "validator-fn")))))
