(guard (e (#t #f)) (jolt-invoke4 (var-deref "clojure.core" "attach-core-doc-meta!") "clojure.core" "alter" "Must be called in a transaction. Sets the in-transaction-value of\n  ref to:\n\n  (apply fun in-transaction-value-of-ref args)\n\n  and returns the in-transaction-value of ref." (jolt-list (jolt-vector (jolt-symbol #f "ref") (jolt-symbol #f "fun") (jolt-symbol #f "&") (jolt-symbol #f "args")))))
