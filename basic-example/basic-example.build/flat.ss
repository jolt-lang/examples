(guard (e (#t #f)) (jolt-invoke4 (var-deref "clojure.core" "attach-core-doc-meta!") "clojure.core" "satisfies?" "Returns true if x satisfies the protocol" (jolt-list (jolt-vector (jolt-symbol #f "protocol") (jolt-symbol #f "x")))))
