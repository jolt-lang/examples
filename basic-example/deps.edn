{:paths ["src"]

 ;; app.core uses clojure.string and nothing else. jolt-lang/nrepl is here only
 ;; for `jolt nrepl-server`, which composes the :nrepl/middleware below over
 ;; jolt's built-in server so an editor gets sessions, completion and lookup.
 ;; nrepl-example shows an app that starts its own nREPL server.
 :deps {jolt-lang/nrepl
        {:git/url "https://github.com/jolt-lang/nrepl"
         :git/tag "v0.4.4" :git/sha "cc5a82c734fbaad9aacb951a2fca81597f2d1cdb"}}

 :nrepl/middleware [nrepl.middleware/default-middleware]

 :aliases {:test {:extra-paths ["test"]
                  :main-opts ["-m" "app.core-test"]}}

 :tasks {start {:doc "run the app: prints a greeting and exits"
               :main-opts ["-m" "app.core"]}
         test "jolt -M:test"}

 :jolt/build {:opt true
              :direct-link true
              :tree-shake true}}
