{;; jolt.ffi/write takes the value BEFORE the offset as of jolt 0.8.0, and the
 ;; two spellings are both integers — an older runtime writes to the wrong
 ;; place rather than failing. Declare the floor so it refuses instead.
 :jolt/min-version "0.8.0"

 :paths ["src"]

 :deps {jolt-lang/glimmer-gl  {:local/root "../../glimmer-gl"}
        jolt-lang/glimmer-gtk {:local/root "../../glimmer-gtk"}
        jolt-lang/glimmer     {:local/root "../../glimmer"}}

 ;; Native libs (OpenGL from glimmer-gl, GTK4/GLib from glimmer-gtk) are declared
 ;; in those deps' :jolt/native entries and merged by jolt's dependency walk.

 :aliases {:run   {:main-opts ["-m" "fps-demo.core"]}
           :check {:main-opts ["-m" "fps-demo.check"]}
           :timing {:main-opts ["-m" "fps-demo.timing"]}
           :perf   {:main-opts ["-m" "fps-demo.perf"]}}

 :tasks {run   "jolt -M:run"
         check "jolt -M:check"}}
