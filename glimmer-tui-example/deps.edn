{:paths ["src"]

 ;; glimmer-tui is the terminal backend; it brings glimmer, the toolkit-
 ;; independent reactive core, along transitively, together with the ncursesw
 ;; :jolt/native declaration that jolt's dependency walk merges into this
 ;; project. So there is nothing to declare here and nothing to install: the
 ;; backend binds the ncurses that macOS and every Linux already ship.
 :deps {jolt-lang/glimmer-tui {:git/url "https://github.com/jolt-lang/glimmer-tui"
                               :git/tag "v0.2.3"
                               :git/sha "99ea2196c77fc132eb76d3b2eab3b129d72c522f"}}

 ;; `jolt -M:run` (or the `run` task) takes over the terminal and blocks until
 ;; you quit with ctrl-c or the Quit button.
 :aliases {:run {:main-opts ["-m" "tui-demo.core"]}}

 :tasks {run "jolt -M:run"}}
