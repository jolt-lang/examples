{:paths ["src" "resources"]

 ;; A minimal datastar demo: the HTTP server is ring-chez-adapter (BSD sockets
 ;; over jolt.ffi); the datastar middleware is jolt-lang/glimmer-datastar, whose
 ;; own deps (glimmer, clojure.data.json, jolt-lang/time) jolt expands
 ;; transitively.
 :deps {jolt-lang/ring-chez-adapter
        {:git/url "https://github.com/jolt-lang/ring-chez-adapter"
         :git/tag "v0.7.15"
         :git/sha "f491a05452ef80ef4112cd21aa88145411577143"}
        jolt-lang/glimmer-datastar
        {:git/url "https://github.com/jolt-lang/glimmer-datastar"
         :git/tag "v0.1.7"
         :git/sha "2c8024eb6c05282ea9a062942b28af1cd3c9bd09"}
        ;; hiccup 2.0.0 (verified jolt-compatible; see examples/hiccup-app)
        weavejester/hiccup
        {:git/url "https://github.com/weavejester/hiccup"
         :git/sha "b6b12097ba973141fe87c1b4d6a27ddcce5d5929"}}

 ;; `jolt build -m app.core` bakes resources/ (the vendored datastar.js) into
 ;; the binary.
 :jolt/build {:embed ["resources"]}

 :aliases {:test {:extra-paths ["test"]
                 :main-opts   ["-m" "app.core-test"]}}

 :tasks {serve {:doc "run the server" :main-opts ["-m" "app.core"]}
         test  "jolt -M:test"}}
